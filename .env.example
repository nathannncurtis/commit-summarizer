GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
# Preferred: bot token (xoxb-...) so posted summaries can be edited later.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Legacy fallback if no bot token is set. Webhook posts can never be edited.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SIGNING_SECRET=your-slack-app-signing-secret
SLACK_ALLOWED_CHANNEL_ID=C0XXXXXXXXX
# Slack member ID allowed to edit summaries by DMing the bot (profile → Copy member ID)
SLACK_ADMIN_USER_ID=U0XXXXXXXXX
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
PORT=5000
BIND_HOST=0.0.0.0
